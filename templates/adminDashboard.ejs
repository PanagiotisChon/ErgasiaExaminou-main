<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Admin Dashboard</title>
    <style>
        body {
            font-family: 'Times New Roman', Times, serif;
            background-color: #f4f4f4;
            margin: 0;
            padding: 0;
            display: flex;
            justify-content: center;
            align-items: center;
            height: 100vh;
        }
        .dashboard-container {
            background-color: #e7e1ca;
            padding: 40px;
            border-radius: 10px;
            box-shadow: 0 4px 10px rgba(0, 0, 0, 0.2);
            text-align: center;
            max-width: 600px;
            width: 100%;
            position: relative;
        }
        h1 {
            font-size: 36px;
            color: #333;
            margin-bottom: 20px;
        }
        .dashboard-buttons {
            display: flex;
            flex-direction: column;
            gap: 15px;
        }
        .dashboard-btn {
            font-family: 'Times New Roman', Times, serif;
            padding: 15px;
            font-size: 22px;
            border: none;
            background-color: #333;
            color: #fff;
            cursor: pointer;
            border-radius: 5px;
            transition: background-color 0.3s;
            width: 100%;
            box-sizing: border-box;
        }
        .dashboard-btn:hover {
            background-color: #555;
        }
        .logout-btn {
            background-color: #dc3545;
        }
        .logout-btn:hover {
            background-color: #c00013;
        }
        p {
            font-size: 14px;
            color: #666;
        }
        a {
            color: #007BFF;
            text-decoration: none;
        }
        a:hover {
            text-decoration: underline;
        }
    </style>
</head>
<body>

    <div class="dashboard-container">
        <h1>Welcome, <span id="username"></span></h1>

        <div class="dashboard-buttons">
            <button class="dashboard-btn" onclick="window.location.href='/admin/manage-registration-requests'">Registration Requests</button>
            <button class="dashboard-btn" onclick="window.location.href='/admin/manage-users'">User management</button>
            <button class="dashboard-btn" onclick="window.location.href='/admin/manage-system-structure'">Structural Elements</button>
            <button class="dashboard-btn" onclick="window.location.href='/admin/manage-announcements'">Management of Announcements/Offers</button>
            <button class="dashboard-btn logout-btn" onclick="window.location.href='/logout'">Logout</button>
        </div>
    </div>

    <script>
        // Ανάκτηση του username που έχει περαστεί από το server
        const username = "<%= username %>";
        document.getElementById('username').textContent = username;
    </script>
</body>
</html>