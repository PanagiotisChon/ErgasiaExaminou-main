<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Schedule</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: "Times New Roman", Times, serif;
        }
    </style>
    <script defer>
        document.addEventListener('DOMContentLoaded', () => {
        const programSelect = document.getElementById('program');
        const trainerSelect = document.getElementById('trainer');

        // Populate trainers when program changes in the add form
        programSelect.addEventListener('change', async () => {
            await populateTrainers(programSelect.value, trainerSelect);
        });

        // Handle modal opening for editing
        const editModals = document.querySelectorAll('.modal');
        editModals.forEach(modal => {
            const programSelectInModal = modal.querySelector('select[name="programName"]');
            const trainerSelectInModal = modal.querySelector('select[name="trainerName"]');

            // Populate trainers based on selected program when opening modal
            modal.addEventListener('show.bs.modal', async () => {
                await populateTrainers(programSelectInModal.value, trainerSelectInModal);

                // Set the current trainer as selected
                const currentTrainer = modal.dataset.currentTrainer;
                if (currentTrainer) {
                    trainerSelectInModal.value = currentTrainer;
                }
            });

            // Update trainers dynamically when program changes in modal
            programSelectInModal.addEventListener('change', async () => {
                await populateTrainers(programSelectInModal.value, trainerSelectInModal);
            });
        });

        // Function to populate trainers
        async function populateTrainers(programName, trainerSelectElement) {
            if (!programName) return;

            try {
                const response = await fetch(`/admin/trainers-by-program?programName=${programName}`);
                const trainers = await response.json();

                // Clear existing options
                trainerSelectElement.innerHTML = '<option value="" disabled selected>Select a trainer</option>';

                // Populate trainers dynamically
                trainers.forEach(trainer => {
                    const option = document.createElement('option');
                    option.value = `${trainer.firstName} ${trainer.lastName}`;
                    option.textContent = `${trainer.firstName} ${trainer.lastName}`;
                    trainerSelectElement.appendChild(option);
                });
            } catch (error) {
                console.error('Error fetching trainers:', error);
            }
        }
    });
    </script>
</head>
<body class="bg-light">
    <div class="container my-5">
        <h1 class="mb-4">Manage Schedule</h1>

        <% if (flashMessage) { %>
            <div class="flash-message <%= flashMessage.type %>">
                <%= flashMessage.text %>
            </div>
            <script>
                setTimeout(function () {
                    const flashMessage = document.querySelector('.flash-message');
                    if (flashMessage) {
                        flashMessage.style.display = 'none';
                    }
                }, 5000);
            </script>
        <% } %>
        
        <!-- Form to add a new schedule -->
        <form action="/admin/schedule" method="POST">
            <div class="mb-3">
                <label for="program" class="form-label">Program:</label>
                <select name="programName" id="program" class="form-select" required>
                    <option value="" disabled selected>Select a program</option>
                    <% programs.forEach(program => { %>
                        <option value="<%= program.name %>"><%= program.name %></option>
                    <% }); %>
                </select>
            </div>

            <div class="mb-3">
                <label for="trainer" class="form-label">Trainer:</label>
                <select name="trainerName" id="trainer" class="form-select" required>
                    <option value="" disabled selected>Select a trainer</option>
                </select>
            </div>

            <div class="mb-3">
                <label for="day" class="form-label">Day:</label>
                <input type="date" id="day" name="day" class="form-control" required>
            </div>

            <div class="mb-3">
                <label for="time" class="form-label">Time:</label>
                <input type="time" id="time" name="time" class="form-control" required>
            </div>

            <div class="mb-3">
                <label for="capacity" class="form-label">Capacity:</label>
                <input type="number" id="capacity" name="capacity" class="form-control" min="1" required>
            </div>

            <button type="submit" class="btn btn-primary">Add Schedule</button>
            <a href="/admin/manage-system-structure" class="btn btn-secondary">Go Back</a>
        </form>

        <!-- Schedule list -->
        <h2 class="my-4">Existing Schedules</h2>
        <table class="table table-bordered">
            <thead>
                <tr>
                    <th>Program</th>
                    <th>Trainer</th>
                    <th>Day</th>
                    <th>Time</th>
                    <th>Capacity</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                <% if (schedule.length > 0) { %>
                    <% schedule.forEach(schedule => { %>
                        <tr>
                            <td><%= schedule.programName %></td>
                            <td><%= schedule.trainerName %></td>
                            <td><%= schedule.day %></td>
                            <td><%= schedule.time %></td>
                            <td><%= schedule.capacity %></td>
                            <td>
                                <div class="d-flex align-items-center gap-2">
                                    <!-- Edit Button -->
                                    <button type="button" class="btn btn-warning btn-sm" data-bs-toggle="modal" data-bs-target="#editModal<%= schedule._id %>">Edit</button>
                            
                                    <!-- Delete Form -->
                                    <form action="/admin/schedule/delete/<%= schedule._id %>" method="POST">
                                        <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this schedule?');">Delete</button>
                                    </form>
                                </div>
                            </td>
                        </tr>

                        <!-- Edit Modal -->
                        <div class="modal fade" id="editModal<%= schedule._id %>" tabindex="-1" aria-labelledby="editModalLabel<%= schedule._id %>" aria-hidden="true" data-current-trainer="<%= schedule.trainerName %>">
                            <div class="modal-dialog">
                                <div class="modal-content">
                                    <div class="modal-header">
                                        <h5 class="modal-title" id="editModalLabel<%= schedule._id %>">Edit Schedule</h5>
                                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                    </div>
                                    <div class="modal-body">
                                        <form action="/admin/schedule/update/<%= schedule._id %>" method="POST">
                                            <div class="mb-3">
                                                <label for="program<%= schedule._id %>" class="form-label">Program:</label>
                                                <select name="programName" id="program<%= schedule._id %>" class="form-select" required>
                                                    <option value="" disabled>Select a program</option>
                                                    <% programs.forEach(program => { %>
                                                        <option value="<%= program.name %>" <%= program.name === schedule.programName ? 'selected' : '' %>><%= program.name %></option>
                                                    <% }); %>
                                                </select>
                                            </div>                       
                                            <div class="mb-3">
                                                <label for="trainer<%= schedule._id %>" class="form-label">Trainer:</label>
                                                <select name="trainerName" id="trainer<%= schedule._id %>" class="form-select" required>
                                                    <option value="" disabled selected>Select a trainer</option>
                                                </select>
                                            </div>
                                            <div class="mb-3">
                                                <label for="day<%= schedule._id %>" class="form-label">Day:</label>
                                                <input type="date" id="day<%= schedule._id %>" name="day" class="form-control" value="<%= schedule.day %>" required>
                                            </div>

                                            <div class="mb-3">
                                                <label for="time<%= schedule._id %>" class="form-label">Time:</label>
                                                <input type="time" id="time<%= schedule._id %>" name="time" class="form-control" value="<%= schedule.time %>" required>
                                            </div>

                                            <div class="mb-3">
                                                <label for="capacity<%= schedule._id %>" class="form-label">Capacity:</label>
                                                <input type="number" id="capacity<%= schedule._id %>" name="capacity" class="form-control" value="<%= schedule.capacity %>" min="1" required>
                                            </div>                        
                                            <button type="submit" class="btn btn-primary">Save Changes</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </div>
                    <% }); %>
                <% } else { %>
                    <tr>
                        <td colspan="6" class="text-center">
                            <div class="flash-message info">
                                No schedule available.                            
                            </div>                        
                        </td>
                    </tr>
                <% } %>
            </tbody>
        </table>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0-alpha1/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>