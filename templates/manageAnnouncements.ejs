<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Announcements</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css">
    <style>
        body {
            font-family: "Times New Roman", Times, serif;
        }
        .flash-message {
            margin-bottom: 30px;
        }
        .go-back-btn {
            display: inline-block;
            margin-bottom: 22px;
            padding: 10px 20px;
            font-size: 16px;
            font-weight: bold;
            border: none;
            background-color: #007bff;
            color: #fff;
            cursor: pointer;
            border-radius: 5px;
            transition: background-color 0.3s;
        }
        .go-back-btn:hover {
            background-color: #0056b3;
        }
    </style>
</head>
<body>
    <div class="container mt-5">
        <h1 class="text-center mb-4">Manage Announcements</h1>

        <% if (flashMessage) { %>
            <div class="flash-message <%= flashMessage.type %>">
                <%= flashMessage.text %>
            </div>
            <script>
                setTimeout(function () {
                    const flashMessage = document.querySelector('.flash-message');
                    if (flashMessage) {
                        flashMessage.style.display = 'none';
                    }
                }, 5000);
            </script>
        <% } %>

        <!-- Add Announcement Form -->
        <div class="card mb-4">
            <div class="card-header bg-primary text-white">Add New Announcement</div>
            <div class="card-body">
                <form action="/admin/announcements" method="POST">
                    <div class="mb-3">
                        <label for="title" class="form-label">Title</label>
                        <input type="text" id="title" name="title" class="form-control" required>
                    </div>
                    <div class="mb-3">
                        <label for="content" class="form-label">Content</label>
                        <textarea id="content" name="content" class="form-control" rows="3" required></textarea>
                    </div>
                    <div class="mb-3">
                        <label for="validUntil" class="form-label">Valid Until</label>
                        <input type="date" id="validUntil" name="validUntil" class="form-control" required>
                    </div>
                    <button type="submit" class="btn btn-primary">Add Announcement</button>
                </form>
            </div>
        </div>
        <button class="go-back-btn" onclick="window.location.href='/admin/dashboard'">Back to Dashboard</button>

        <!-- Announcements List -->
        <div class="card">
            <div class="card-header bg-secondary text-white">Current Announcements</div>
            <ul class="list-group list-group-flush">
                <% announcements.forEach(announcement => { %>
                    <li class="list-group-item">
                        <div class="d-flex justify-content-between align-items-center">
                            <div>
                                <h5><%= announcement.title %></h5>
                                <p><%= announcement.content %></p>
                                <small>Valid Until: <%= (new Date(announcement.validUntil)).toISOString().split('T')[0] %></small>
                            </div>
                            <div>
                                <!-- Update Button -->
                                <button class="btn btn-warning btn-sm me-2" data-bs-toggle="modal" data-bs-target="#updateModal-<%= announcement._id %>">Update</button>

                                <!-- Delete Form -->
                                <form action="/admin/announcements/delete/<%= announcement._id %>" method="POST" class="d-inline">
                                    <button type="submit" class="btn btn-danger btn-sm" onclick="return confirm('Are you sure you want to delete this program?');">Delete</button>
                                </form>
                            </div>
                        </div>
                    </li>

                    <!-- Update Modal -->
                    <div class="modal fade" id="updateModal-<%= announcement._id %>" tabindex="-1" aria-labelledby="updateModalLabel-<%= announcement._id %>" aria-hidden="true">
                        <div class="modal-dialog">
                            <div class="modal-content">
                                <div class="modal-header">
                                    <h5 class="modal-title" id="updateModalLabel-<%= announcement._id %>">Update Announcement</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                <div class="modal-body">
                                    <form action="/admin/announcements/update/<%= announcement._id %>" method="POST">
                                        <div class="mb-3">
                                            <label for="title-<%= announcement._id %>" class="form-label">Title</label>
                                            <input type="text" id="title-<%= announcement._id %>" name="title" class="form-control" value="<%= announcement.title %>" required>
                                        </div>
                                        <div class="mb-3">
                                            <label for="content-<%= announcement._id %>" class="form-label">Content</label>
                                            <textarea id="content-<%= announcement._id %>" name="content" class="form-control" rows="3" required><%= announcement.content %></textarea>
                                        </div>
                                        <div class="mb-3">
                                            <label for="validUntil-<%= announcement._id %>" class="form-label">Valid Until</label>
                                            <input type="date" id="validUntil-<%= announcement._id %>" name="validUntil" class="form-control" value="<%= (new Date(announcement.validUntil)).toISOString().split('T')[0] %>" required>
                                        </div>
                                        <button type="submit" class="btn btn-success">Save Changes</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </div>
                <% }); %>
            </ul>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
