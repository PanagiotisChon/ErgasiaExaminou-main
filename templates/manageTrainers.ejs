<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Manage Trainers</title>
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        body {
            font-family: 'Times New Roman', Times, serif;
            background-color: #f9f9f9;
            color: #333;
            margin: 0;
            padding: 0;
        }
        header {
            background-color: #2C3E50;
            color: white;
            padding: 30px;
            text-align: center;
            font-size: 2em;
            letter-spacing: 1px;
        }
        main {
            padding: 40px 20px;
            max-width: 1200px;
            margin: 0 auto;
        }
        section {
            margin-top: 30px;
            margin-bottom: 30px;
            background-color: #e2e1b0;
            padding: 20px;
            border-radius: 10px;
            box-shadow: 10px 5px 8px rgba(0, 0, 0, 0.1);
        }
        h2 {
            font-size: 1.5em;
            color: #2C3E50;
        }
        label {
            font-weight: bold;
            display: block;
            margin: 10px 0 5px;
        }
        input[type="text"], select, input[type="checkbox"] {
            padding: 12px;
            margin-bottom: 15px;
            width: 100%;
            border: 1px solid #BDC3C7;
            border-radius: 5px;
            box-sizing: border-box;
        }
        input[type="checkbox"] {
            width: auto;
            margin-right: 10px;
        }
        button {
            font-family: 'Times New Roman', Times, serif;
            background-color: #27AE60;
            color: white;
            border: none;
            cursor: pointer;
            margin-top: 20px;
            padding: 12px 20px;
            border-radius: 5px;
            font-size: 1em;
            transition: background-color 0.3s ease;
        }
        button:hover {
            background-color: #2ECC71;
        }
        button.update {
            background-color: #ceaf02;
            color: rgb(0, 0, 0);
        }
        button.update:hover {
            background-color: #b89c03;
        }
        table {
            width: 100%;
            border-collapse: collapse;
            margin-top: 20px;
        }
        th, td {
            padding: 12px;
            text-align: left;
            border: 1px solid #BDC3C7;
        }
        th {
            background-color: #ECF0F1;
            color: #2C3E50;
        }
        tr:hover {
            background-color: #F1F1F1;
        }
        td form {
            display: inline-block;
            margin-right: 10px;
        }
        td form button {
            background-color: #E74C3C;
        }
        td form button:hover {
            background-color: #C0392B;
        }
        .form-row {
            display: flex;
            flex-wrap: wrap;
            gap: 10px;
        }
        .form-row label {
            flex: 1;
            min-width: 120px;
        }
        .form-row input[type="text"], .form-row select {
            flex: 2;
        }
        .checkbox-group {
            display: flex;
            flex-wrap: wrap;
            gap: 15px;
        }
        .checkbox-group input[type="checkbox"] {
            width: auto;
        }
        .go-back-btn {
            display: inline-block;
            margin-top: 20px;
            padding: 10px 20px;
            font-size: 16px;
            font-weight: bold;
            border: none;
            background-color: #007bff;
            color: #fff;
            cursor: pointer;
            border-radius: 5px;
            text-decoration: none;
            transition: background-color 0.3s;
        }
        .go-back-btn:hover {
            background-color: #0056b3;
        }
        @media (max-width: 768px) {
            main {
                padding: 20px;
            }
            .form-row {
                flex-direction: column;
            }
            .form-row label,
            .form-row input[type="text"], 
            .form-row select {
                width: 100%;
            }
        }
    </style>
</head>
<body>
    <header>Manage Trainers</header>
    
    <main>
        <!-- Προσθήκη Νέου Γυμναστή -->
        <section>
            <h2>Add New Trainer</h2>
            <form action="/admin/trainers" method="POST">
                <div class="form-row">
                    <label for="firstName">First Name:</label>
                    <input type="text" id="firstName" name="firstName" required>
                </div>
                <div class="form-row">
                    <label for="lastName">Last Name:</label>
                    <input type="text" id="lastName" name="lastName" required>
                </div>
                <div class="form-row">
                    <label for="specialty">Specialty:</label>
                    <div class="checkbox-group">
                        <% if (programs.length > 0) { %>
                            <% programs.forEach(program => { %>
                                <div>
                                    <input type="checkbox" id="<%= program._id %>" name="specialty" value="<%= program.name %>">
                                    <span><%= program.name %></span>
                                </div>
                            <% }); %>
                        <% } else { %>
                            <div class="text-center">
                                <div class="flash-message info">
                                    No programs found.
                                </div>                        
                            </div>
                        <% } %>                        
                    </div>
                </div>
                <button type="submit">Add Trainer</button>
            </form>
            <button class="go-back-btn" onclick="window.location.href='/admin/manage-system-structure'">Go Back</button>
        </section>
        <% if (flashMessage) { %>
            <div class="flash-message <%= flashMessage.type %>">
                <%= flashMessage.text %>
            </div>
            <script>
                setTimeout(function () {
                    const flashMessage = document.querySelector('.flash-message');
                    if (flashMessage) {
                        flashMessage.style.display = 'none';
                    }
                }, 5000);
            </script>
        <% } %>
        <!-- Λίστα Υφιστάμενων Γυμναστών -->
        <section>
            <h2>Existing Trainers</h2>
            <table>
                <thead>
                    <tr>
                        <th>Name</th>
                        <th>Specialty</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    <% if (trainers.length > 0) { %>
                        <% trainers.forEach(trainer => { %>
                            <tr>
                                <td><%= trainer.firstName %> <%= trainer.lastName %></td>
                                <td><%= trainer.specialty.join(", ") %></td>
                                <td>
                                    <!-- Φόρμα Ενημέρωσης -->
                                    <form action="/admin/trainers/update/<%= trainer._id %>" method="POST" style="display: inline;">
                                        <input type="text" name="firstName" value="<%= trainer.firstName %>" required>
                                        <input type="text" name="lastName" value="<%= trainer.lastName %>" required>
                                        <div class="checkbox-group">
                                            <% if (programs.length > 0) { %>
                                                <% programs.forEach(program => { %>
                                                    <div>
                                                        <input 
                                                            type="checkbox" 
                                                            id="<%= program._id %>" 
                                                            name="specialty" 
                                                            value="<%= program.name %>" 
                                                            <%= trainer.specialty.includes(program.name) ? 'checked' : '' %> 
                                                        >
                                                        <span><%= program.name %></span>
                                                    </div>
                                                <% }); %>
                                            <% } else { %>
                                                <div class="text-center">
                                                    <div class="flash-message info">
                                                        No programs found.
                                                    </div>
                                                </div>
                                            <% } %>
                                        </div>
                                        <button type="submit" class="update">Update</button>
                                    </form>
                                    
                                    <!-- Φόρμα Διαγραφής -->
                                    <form action="/admin/trainers/delete/<%= trainer._id %>" method="POST" style="display: inline;">
                                        <button type="submit" onclick="return confirm('Are you sure you want to delete this trainer?');">Delete</button>
                                    </form>
                                </td>
                            </tr>
                        <% }); %>
                    <% } else { %>
                        <tr>
                            <td colspan="3">
                                <div class="flash-message info">
                                    No trainers available.
                                </div>
                            </td>
                        </tr>
                    <% } %>
                </tbody>
            </table>
        </section>
    </main>
</body>
</html>