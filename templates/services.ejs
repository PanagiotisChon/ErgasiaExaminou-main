<!DOCTYPE html>
<html lang="el">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Schedule & Availability</title>
    <link rel="stylesheet" href="/css/styles.css">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/css/bootstrap.min.css" rel="stylesheet">
    <style>
        body {
            font-family: "Times New Roman", Times, serif;
            background: linear-gradient(1350deg, #ebc174, #9fa4e6);
            color: #333;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
        }
        h1, h2, h3 {
            color: #000000;
            text-shadow: 2px 2px 4px rgba(0, 0, 0, 0.5);
        }
        .card {
            border-radius: 15px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.2);
            margin-bottom: 20px;
            background-color: #d4d4d4;
        }
        .flash-message {
            margin-bottom: 20px;
        }
        .btn {
            border-radius: 20px;
            transition: transform 0.2s ease-in-out;
        }
        .btn:hover {
            transform: scale(1.1);
        }
        table {
            border-radius: 10px;
            overflow: hidden;
        }
        th {
            text-align: center;
            background-color: #007bff;
            color: #fff;
        }
        td {
            vertical-align: middle;
            text-align: center;
        }
        .container {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
    </style>
</head>
<body>
    <div class="container py-4">
        <h1 class="mb-4 text-center">Διαθεσιμότητα Προγραμμάτων</h1>
        
        <div class="card p-4">
            <h2 class="card-title text-center mb-3">Αναζήτηση Διαθεσιμότητας</h2>
            <form action="/user/availability" method="get" class="row g-3">
                <div class="col-md-6">
                    <label for="programId" class="form-label">Επιλέξτε Πρόγραμμα:</label>
                    <select name="programId" id="programId" class="form-select" required>
                        <option value="" disabled selected>Επιλέξτε πρόγραμμα</option>
                        <% programs.forEach(function(program) { %>
                            <option value="<%= program._id %>"><%= program.name %></option>
                        <% }); %>
                    </select>
                </div>

                <div class="col-md-6">
                    <label for="date" class="form-label">Ημερομηνία:</label>
                    <input type="date" id="date" name="date" class="form-control" required min="<%= new Date().toISOString().split('T')[0] %>">
                </div>

                <div class="col-12 text-center">
                    <button type="submit" class="btn btn-primary px-4">Αναζήτηση</button>
                </div>
            </form>
        </div>

        <% if (flashMessage) { %>
            <div class="flash-message <%= flashMessage.type %>">
                <%= flashMessage.text %>
            </div>
            <script>
                setTimeout(function () {
                    const flashMessage = document.querySelector('.flash-message');
                    if (flashMessage) {
                        flashMessage.style.display = 'none';
                    }
                }, 5000);
            </script>
        <% } %>

        <% if (availableSessions && availableSessions.length > 0) { %>
            <h3 class="mt-4">Διαθέσιμες Συνεδρίες</h3>
            <table class="table table-bordered table-striped">
                <thead>
                    <tr>
                        <th>Ημερομηνία</th>
                        <th>Ώρα</th>
                        <th>Όνομα Εκπαιδευτή</th>
                        <th>Χωρητικότητα</th>
                        <th>Κράτηση</th>
                    </tr>
                </thead>
                <tbody>
                    <% availableSessions.forEach(function(session) { %>
                        <tr>
                            <td><%= session.day %></td>
                            <td><%= session.time %></td>
                            <td><%= session.trainerName %></td>
                            <td><%= session.capacity %></td>
                            <td>
                                <% if (session.capacity > 0) { %>
                                    <form action="/user/book-appointment" method="post">
                                        <input type="hidden" name="sessionId" value="<%= session._id %>" />
                                        <button type="submit" class="btn btn-success">Κλείσιμο</button>
                                    </form>
                                <% } else { %>
                                    <button class="btn btn-secondary" disabled>Πλήρης</button>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        <% } %>

        <h3 class="mt-4">Καταχωρημένα Ραντεβού</h3>
        <% if (appointments && appointments.length > 0) { %>
            <table class="table table-hover">
                <thead>
                    <tr>
                        <th>Όνομα Χρήστη</th>
                        <th>Πρόγραμμα</th>
                        <th>Εκπαιδευτής</th>
                        <th>Ημερομηνία</th>
                        <th>Ώρα</th>
                        <th>Κατάσταση</th>
                        <th>Ενέργειες</th>
                    </tr>
                </thead>
                <tbody>
                    <% appointments.forEach(function(appointment) { %>
                        <tr>
                            <td><%= appointment.username %></td>
                            <td><%= appointment.programName %></td>
                            <td><%= appointment.trainerName %></td>
                            <td><%= appointment.day %></td>
                            <td><%= appointment.time %></td>
                            <td><%= appointment.status %></td>
                            <td>
                                <% 
                                let appointmentDate = new Date(appointment.day + 'T' + appointment.time);
                                let now = new Date();
                                let twoHoursBefore = new Date(appointmentDate.getTime() - 2 * 60 * 60 * 1000);
                                %>
                                <% if (appointment.status === 'booked' && now < twoHoursBefore) { %>
                                    <form action="/user/cancel-appointment" method="post">
                                        <input type="hidden" name="appointmentId" value="<%= appointment._id %>" />
                                        <button type="submit" class="btn btn-danger">Ακύρωση</button>
                                    </form>
                                <% } else { %>
                                    <button class="btn btn-secondary" disabled>Ακύρωση</button>
                                <% } %>
                            </td>
                        </tr>
                    <% }); %>
                </tbody>
            </table>
        <% } else { %>
            <div class="flash-message info">
                Δεν υπάρχουν καταχωρημένα ραντεβού.        
            </div>  
        <% } %>

        <!-- Button to go back to userDashboard -->
        <div class="text-center mt-4">
            <a href="/user/dashboard" class="btn btn-outline-light">Go Back</a>
        </div>
    </div>

    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.1.3/dist/js/bootstrap.bundle.min.js"></script>
</body>
</html>
